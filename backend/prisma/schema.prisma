generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  CLUB_MANAGER
  PLAYER
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  DRAW_PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FormatType {
  SINGLES_MATCHPLAY
  SINGLES_STROKEPLAY
  SINGLES_STABLEFORD
  PAIRS_MATCHPLAY
  PAIRS_BESTBALL
  PAIRS_FOURSOMES
  PAIRS_GREENSOMES
  TEAM_MATCHPLAY
  TEAM_STROKEPLAY
  TEAM_STABLEFORD
}

enum ScoringSystem {
  MATCHPLAY
  STROKEPLAY
  STABLEFORD
  BEST_BALL
}

enum TournamentStage {
  CLUB_QUALIFIER
  REGIONAL
  NATIONAL_FINAL
}

enum AgeCategory {
  OPEN
  JUNIOR
  SENIOR
}

enum MatchStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  RESULT_SUBMITTED
  RESULT_CONFIRMED
  COMPLETED
  WALKOVER
  DISPUTED
}

enum EntryStatus {
  REGISTERED
  PAYMENT_PENDING
  ACTIVE
  ELIMINATED
  WITHDRAWN
  DISQUALIFIED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum SponsorTier {
  NATIONAL
  REGIONAL
  LOCAL
  CLUB
}

enum FeeType {
  ENTRY_FEE
  LATE_ENTRY
  PLAYER_MEMBERSHIP
  CLUB_SUBSCRIPTION
  SPECTATOR
  OTHER
}

enum RevenueType {
  ENTRY_FEE
  SPONSORSHIP
  ADVERTISING
  MEMBERSHIP
  CLUB_SUBSCRIPTION
  OTHER
}

enum DrawStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

// ─── MODELS ─────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          UserRole @default(PLAYER)
  isActive      Boolean  @default(true) @map("is_active")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  player      Player?
  clubManager ClubManager?

  @@map("users")
}

model Player {
  id              String  @id @default(uuid())
  userId          String  @unique @map("user_id")
  firstName       String  @map("first_name")
  lastName        String  @map("last_name")
  phone           String?
  dateOfBirth     DateTime? @map("date_of_birth")
  avatarUrl       String?   @map("avatar_url")
  homeClubId      String?   @map("home_club_id")
  whsHandicapId   String?   @map("whs_handicap_id")
  handicapIndex   Decimal?  @map("handicap_index") @db.Decimal(4, 1)
  rankingPoints   Int       @default(0) @map("ranking_points")
  membershipType  String    @default("free") @map("membership_type")
  membershipExpiry DateTime? @map("membership_expiry")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeClub Club?  @relation(fields: [homeClubId], references: [id])

  entries       TournamentEntry[]
  matchesAsA    Match[]           @relation("PlayerA")
  matchesAsB    Match[]           @relation("PlayerB")
  matchesWon    Match[]           @relation("MatchWinner")
  resultsSubmitted MatchResult[]  @relation("ResultSubmitter")
  resultsConfirmed MatchResult[]  @relation("ResultConfirmer")

  @@map("players")
}

model Club {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  address     String?
  city        String?
  county      String?
  postcode    String?
  regionId    String? @map("region_id")
  phone       String?
  email       String?
  website     String?
  logoUrl     String? @map("logo_url")
  description String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  region   Region? @relation(fields: [regionId], references: [id])
  players  Player[]
  managers ClubManager[]
  entries  TournamentEntry[]
  matches  Match[]
  sponsors Sponsor[]
  tournamentClubStages TournamentClubStage[]

  @@map("clubs")
}

model ClubManager {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  clubId    String   @map("club_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id])

  @@map("club_managers")
}

model Region {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  clubs      Club[]
  sponsors   Sponsor[]

  @@map("regions")
}

// ─── TOURNAMENTS ────────────────────────────────────────────────────────────

model Tournament {
  id                   String           @id @default(uuid())
  name                 String
  slug                 String           @unique
  season               String
  description          String?
  rulesText            String?          @map("rules_text")
  status               TournamentStatus @default(DRAFT)
  formatType           FormatType       @map("format_type")
  scoringSystem        ScoringSystem    @map("scoring_system")
  teamSize             Int              @default(1) @map("team_size")
  isKnockout           Boolean          @default(true) @map("is_knockout")
  handicapAllowancePct Int              @default(100) @map("handicap_allowance_pct")
  maxHandicap          Decimal?         @map("max_handicap") @db.Decimal(4, 1)
  ageCategory          AgeCategory      @default(OPEN) @map("age_category")
  minAge               Int?             @map("min_age")
  maxAge               Int?             @map("max_age")
  registrationOpens    DateTime?        @map("registration_opens")
  registrationDeadline DateTime?        @map("registration_deadline")
  startDate            DateTime?        @map("start_date")
  endDate              DateTime?        @map("end_date")
  bannerUrl            String?          @map("banner_url")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  pricing    TournamentPricing[]
  entries    TournamentEntry[]
  stages     TournamentStage_[]
  matches    Match[]
  draws      Draw[]
  sponsors   Sponsor[]
  clubStages TournamentClubStage[]

  @@map("tournaments")
}

model TournamentStage_ {
  id            String          @id @default(uuid())
  tournamentId  String          @map("tournament_id")
  stage         TournamentStage
  stageOrder    Int             @map("stage_order")
  name          String
  totalRounds   Int             @default(1) @map("total_rounds")
  matchDeadlineDays Int?        @map("match_deadline_days")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, stage])
  @@map("tournament_stages")
}

model TournamentClubStage {
  id           String @id @default(uuid())
  tournamentId String @map("tournament_id")
  clubId       String @map("club_id")
  maxEntries   Int?   @map("max_entries")
  qualifyCount Int    @default(1) @map("qualify_count")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  club       Club       @relation(fields: [clubId], references: [id])

  @@unique([tournamentId, clubId])
  @@map("tournament_club_stages")
}

// ─── PRICING (Admin-Configurable) ───────────────────────────────────────────

model TournamentPricing {
  id                String   @id @default(uuid())
  tournamentId      String   @map("tournament_id")
  feeType           FeeType  @map("fee_type")
  amountPence       Int      @map("amount_pence")
  currency          String   @default("GBP")
  clubSharePct      Int      @map("club_share_pct")
  platformSharePct  Int      @map("platform_share_pct")
  description       String?
  isActive          Boolean  @default(true) @map("is_active")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_pricing")
}

model PlatformPricing {
  id            String   @id @default(uuid())
  pricingKey    String   @unique @map("pricing_key")
  amountPence   Int      @map("amount_pence")
  currency      String   @default("GBP")
  description   String?
  effectiveFrom DateTime @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("platform_pricing")
}

// ─── ENTRIES ────────────────────────────────────────────────────────────────

model TournamentEntry {
  id               String      @id @default(uuid())
  tournamentId     String      @map("tournament_id")
  playerId         String      @map("player_id")
  clubId           String      @map("club_id")
  stage            TournamentStage @default(CLUB_QUALIFIER)
  entryFeePaidPence Int?       @map("entry_fee_paid_pence")
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  stripePaymentId  String?     @map("stripe_payment_id")
  handicapAtEntry  Decimal?    @map("handicap_at_entry") @db.Decimal(4, 1)
  seed             Int?
  status           EntryStatus @default(REGISTERED)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id])
  club       Club       @relation(fields: [clubId], references: [id])

  @@unique([tournamentId, playerId])
  @@map("tournament_entries")
}

// ─── DRAWS (Live Scheduled) ─────────────────────────────────────────────────

model Draw {
  id            String      @id @default(uuid())
  tournamentId  String      @map("tournament_id")
  stage         TournamentStage
  roundNumber   Int         @map("round_number")
  scheduledAt   DateTime    @map("scheduled_at")
  status        DrawStatus  @default(SCHEDULED)
  startedAt     DateTime?   @map("started_at")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("draws")
}

// ─── MATCHES ────────────────────────────────────────────────────────────────

model Match {
  id            String          @id @default(uuid())
  tournamentId  String          @map("tournament_id")
  stage         TournamentStage
  roundNumber   Int             @map("round_number")
  matchNumber   Int             @map("match_number")
  playerAId     String?         @map("player_a_id")
  playerBId     String?         @map("player_b_id")
  venueClubId   String?         @map("venue_club_id")
  scheduledDate DateTime?       @map("scheduled_date")
  status        MatchStatus     @default(PENDING)
  winnerId      String?         @map("winner_id")
  scorecard     Json?
  playedAt      DateTime?       @map("played_at")
  nextMatchId   String?         @map("next_match_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tournament Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerA    Player?     @relation("PlayerA", fields: [playerAId], references: [id])
  playerB    Player?     @relation("PlayerB", fields: [playerBId], references: [id])
  venueClub  Club?       @relation(fields: [venueClubId], references: [id])
  winner     Player?     @relation("MatchWinner", fields: [winnerId], references: [id])
  nextMatch  Match?      @relation("MatchProgression", fields: [nextMatchId], references: [id])
  prevMatches Match[]    @relation("MatchProgression")
  result     MatchResult?

  @@map("matches")
}

model MatchResult {
  id               String   @id @default(uuid())
  matchId          String   @unique @map("match_id")
  resultText       String   @map("result_text")
  scorecardUrl     String?  @map("scorecard_url")
  submittedById    String   @map("submitted_by_id")
  submittedAt      DateTime @default(now()) @map("submitted_at")
  confirmedById    String?  @map("confirmed_by_id")
  confirmedAt      DateTime? @map("confirmed_at")
  isConfirmed      Boolean  @default(false) @map("is_confirmed")
  disputeReason    String?  @map("dispute_reason")

  match       Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedBy Player @relation("ResultSubmitter", fields: [submittedById], references: [id])
  confirmedBy Player? @relation("ResultConfirmer", fields: [confirmedById], references: [id])

  @@map("match_results")
}

// ─── SPONSORS & ADVERTISING ─────────────────────────────────────────────────

model Sponsor {
  id            String      @id @default(uuid())
  name          String
  logoUrl       String?     @map("logo_url")
  website       String?
  tier          SponsorTier
  regionId      String?     @map("region_id")
  clubId        String?     @map("club_id")
  tournamentId  String?     @map("tournament_id")
  contactName   String?     @map("contact_name")
  contactEmail  String?     @map("contact_email")
  contractStart DateTime?   @map("contract_start")
  contractEnd   DateTime?   @map("contract_end")
  annualFeePence Int?       @map("annual_fee_pence")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")

  region     Region?     @relation(fields: [regionId], references: [id])
  club       Club?       @relation(fields: [clubId], references: [id])
  tournament Tournament? @relation(fields: [tournamentId], references: [id])

  @@map("sponsors")
}

// ─── REVENUE TRACKING ───────────────────────────────────────────────────────

model RevenueTransaction {
  id                  String      @id @default(uuid())
  type                RevenueType
  totalAmountPence    Int         @map("total_amount_pence")
  clubAmountPence     Int         @default(0) @map("club_amount_pence")
  platformAmountPence Int         @default(0) @map("platform_amount_pence")
  clubId              String?     @map("club_id")
  tournamentId        String?     @map("tournament_id")
  playerId            String?     @map("player_id")
  stripePaymentId     String?     @map("stripe_payment_id")
  status              PaymentStatus @default(PENDING)
  description         String?
  createdAt           DateTime    @default(now()) @map("created_at")

  @@map("revenue_transactions")
}
