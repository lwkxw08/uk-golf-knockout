DATABASE_URL=postgresql://user:password@localhost:5432/golf_knockout
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRES_IN=7d
PORT=3001

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=noreply@ukgolfknockout.com

# Cloudflare R2 (Scorecard Storage)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT_URL=
CLOUDFLARE_R2_BUCKET_NAME=

# Frontend URL
CLIENT_URL=http://localhost:5173

# Course Data Provider — 'golfcourseapi' (default) or 'englandgolf'
COURSE_DATA_PROVIDER=golfcourseapi

# GolfCourseAPI.com — sign up at https://golfcourseapi.com/sign-in
GOLF_COURSE_API_KEY=

# England Golf WHS Union API — requires formal data partnership
ENGLAND_GOLF_CLIENT_TOKEN=
