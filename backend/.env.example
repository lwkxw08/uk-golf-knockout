DATABASE_URL=postgresql://user:password@localhost:5432/golf_knockout
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRES_IN=7d
PORT=3001
NODE_ENV=development

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=noreply@ukgolfknockout.com

# Cloudflare R2 (File/Image Storage)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=ukgolf-uploads
CLOUDFLARE_R2_PUBLIC_URL=https://uploads.ukgolfknockout.com

# Redis (WebSocket scaling for multi-instance)
REDIS_URL=redis://localhost:6379

# Sentry (Error monitoring)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Logging
LOG_LEVEL=info

# Frontend URL
CLIENT_URL=http://localhost:5173

# Course Data Provider — 'golfcourseapi' (default) or 'englandgolf'
COURSE_DATA_PROVIDER=golfcourseapi

# GolfCourseAPI.com — sign up at https://golfcourseapi.com/sign-in
GOLF_COURSE_API_KEY=

# England Golf WHS Union API — requires formal data partnership
ENGLAND_GOLF_CLIENT_TOKEN=
